# Local development only. Never commit your real .env file.
DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/asphalt_gauntlet?retryWrites=true&w=majority
BACKUP_DIR=./backups
HEALTH_WEBHOOK_URL=

# Web control center
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://127.0.0.1:8080
# Production: your public HTTPS URL, with no trailing slash
WEB_PUBLIC_URL=http://127.0.0.1:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Optional comma-separated Discord user IDs for global web staff access
WEB_STAFF_USER_IDS=
