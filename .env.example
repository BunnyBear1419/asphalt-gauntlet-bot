# Local development only. Never commit your real .env file.
DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/asphalt_gauntlet?retryWrites=true&w=majority
# Optional; defaults to ./backups
BACKUP_DIR=./backups

# Optional: private operations webhook for bot-level heartbeat notifications.
HEALTH_WEBHOOK_URL=

# Optional: comma-separated direct proxy IPs trusted to supply X-Forwarded-For.
# Leave empty unless the reverse proxy peer is known and controlled.
RSL_TRUSTED_PROXY_IPS=
# Website OAuth configuration.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_PUBLIC_URL=http://127.0.0.1:8080
